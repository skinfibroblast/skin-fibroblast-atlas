# list sample folders
dir_name <- list.files()
dir_name
names(dir_name)<-list.files()
dir_name

scRNAlist <- list()
for (i in 1:length(dir_name)) {
  # read 10x data
  counts_list <- Read10X(data.dir = dir_name[i])
  
  # extract count matrix
  counts <- counts_list[[1]]
  
  # ensure cell names
  if (is.null(colnames(counts))) {
    colnames(counts) <- paste0("Cell_", 1:ncol(counts))
  }
  
  # create Seurat object
  scRNAlist[[i]] <- CreateSeuratObject(
    counts = counts,
    min.cells = 3,
    min.features = 300,
    project = dir_name[i]
  )
}

# calculate MT and HB percentages
for(i in 1:length(scRNAlist)){
  sc <- scRNAlist[[i]]
  sc[["mt_percent"]] <- PercentageFeatureSet(sc, pattern = "^MT-")
  HB_genes <- c("HBA1","HBA2","HBB","HBD","HBE1","HBG1","HBG2","HBM","HBQ1","HBZ")
  HB_m <- match(HB_genes, rownames(sc@assays$RNA))
  HB_genes <- rownames(sc@assays$RNA)[HB_m] 
  HB_genes <- HB_genes[!is.na(HB_genes)] 
  sc[["HB_percent"]] <- PercentageFeatureSet(sc, features=HB_genes) 
  scRNAlist[[i]] <- sc
  rm(sc)
}
# filter cells
scRNAlist <- lapply(X = scRNAlist, FUN = function(x){
  x <- subset(x, 
              subset = nFeature_RNA > 300 & nFeature_RNA < 7000 & 
                mt_percent < 20 & 
                HB_percent < 3 & 
                nCount_RNA < quantile(nCount_RNA,0.97) & 
                nCount_RNA > 1000)})



# doublet detection
scRNAlist_clean <- lapply(scRNAlist, function(seu) {
  # convert to SCE
  sce <- as.SingleCellExperiment(seu)
  
  # run scDblFinder
  sce <- scDblFinder(sce) 
  
  # keep singlets
  sce <- sce[, sce$scDblFinder.class == "singlet"]
  
  # convert back to Seurat
  seu_clean <- as.Seurat(sce)
  
  return(seu_clean)
})

# merge samples
scRNAlist <- merge(scRNAlist_clean[[1]], 
                   y = scRNAlist_clean[-1], 
                   add.cell.ids = names(scRNAlist_clean),
                   project = "mus_cell")



# HVG selection & PCA
table(scRNAlist[[]]$orig.ident)

scRNAlist <- NormalizeData(scRNAlist) %>% 
  FindVariableFeatures(selection.method = "vst",nfeatures = 3000) %>% 
  ScaleData() %>% 
  RunPCA(npcs = 30, verbose = T)

# elbow plot
ElbowPlot(scRNAlist,ndims = 30)

# batch correction
scRNAlist <- RunHarmony(scRNAlist, group.by.vars = "orig.ident")
# cluster
scRNAlist <- FindNeighbors(scRNAlist, reduction = "harmony", 
                           dims = 1:30) %>% FindClusters(resolution = 1)
# umap/tsne
scRNAlist <- RunTSNE(scRNAlist, reduction = "harmony", dims = 1:30)
scRNAlist <- RunUMAP(scRNAlist, reduction = "harmony", dims = 1:30)

p1<-DimPlot(scRNAlist,reduction="umap",group.by="orig.ident",raster=FALSE,cols = col);p1
p2<-DimPlot(scRNAlist,reduction="umap",group.by="seurat_clusters",raster=FALSE,cols = col,label = T);p2             

