# Read processed h5ad (after scANVI) back to Seurat
library(sceasy)
library(Seurat)
All_FB <- convertFormat(
  "All_FB_processed_full.h5ad",
  from = "anndata",
  to = "seurat"
)
print(All_FB)

# Clustering and UMAP using scANVI embedding
All_FB <- FindNeighbors(All_FB, reduction = "scANVI", dims = 1:30) %>%
  FindClusters(resolution = 1)

All_FB <- RunUMAP(
  All_FB,
  reduction = "scANVI",
  dims = 1:30,
  umap.method = "uwot",
  metric = "cosine",
  seed.use = 123
)

umap_integrated_fb <- DimPlot(All_FB, reduction = "umap", label = TRUE, raster = FALSE)
ggsave("FB_clusters.png", umap_integrated_fb, width = 15, height = 8)

# Calculate DEGs on scANVI-based clusters
cluster_markers <- FindAllMarkers(
  object = All_FB,
  test.use = "wilcox",
  only.pos = TRUE,
  logfc.threshold = 0.25
)

# Filter top 100 genes per cluster
all.markers <- cluster_markers %>%
  dplyr::select(gene, everything()) %>%
  dplyr::filter(p_val < 0.05)
top10 <- all.markers %>%
  group_by(cluster) %>%
  top_n(n = 100, wt = avg_log2FC)
write.csv(cluster_markers, "all_fb_markers_scanvi.csv", row.names = FALSE)

