# Set working directory
#The 10× sequencing output files (after Cell Ranger processing) are deposited in the directory.

setwd("...:/singlecell")
dir_name <- list.files()
names(dir_name) <- dir_name

# Read 10X data from directories
combined_list <- list()
for (i in 1:length(dir_name)) {
  counts <- Read10X(data.dir = dir_name[i])
  scRNAlist[[dir_name[i]]] <- CreateSeuratObject(
    counts,
    project = dir_name[i],
    min.cells = 3,
    min.features = 300
  )
}

# Calculate mitochondrial and hemoglobin percentages
for (i in 1:length(combined_list)) {
  sc <- combined_list[[i]]
  sc[["mt_percent"]] <- PercentageFeatureSet(sc, pattern = "^MT-")
  HB_genes <- c("HBA1","HBA2","HBB","HBD","HBE1","HBG1","HBG2","HBM","HBQ1","HBZ")
  HB_m <- match(HB_genes, rownames(sc@assays$RNA))
  HB_genes <- rownames(sc@assays$RNA)[HB_m]
  HB_genes <- HB_genes[!is.na(HB_genes)]
  sc[["HB_percent"]] <- PercentageFeatureSet(sc, features = HB_genes)
  combined_list[[i]] <- sc
  rm(sc)
}

# Filter cells based on QC metrics
combined_list <- lapply(combined_list, function(x) {
  subset(x,
         nFeature_RNA > 300 & nFeature_RNA < 7000 &
           mt_percent < 20 & HB_percent < 3 & nCount_RNA > 1000)
})

# Merge all samples
combined_list <- merge(combined_list[[1]], y = combined_list[-1])

# Normalize, find variable features, scale, and run PCA
set.seed(123)
combined_list <- NormalizeData(combined_list) %>%
  FindVariableFeatures(selection.method = "vst", nfeatures = 3000) %>%
  ScaleData() %>%
  RunPCA(npcs = 30, verbose = TRUE, seed.use = 42)

# Harmony integration
scRNA_harmony <- RunHarmony(
  combined_list,
  group.by.vars = "orig.ident",
  random.seed = 123
)

# Clustering, tSNE, and UMAP
scRNA_harmony <- FindNeighbors(scRNA_harmony, reduction = "harmony", dims = 1:30) %>%
  FindClusters(resolution = 3)

scRNA_harmony <- RunTSNE(scRNA_harmony, reduction = "harmony", dims = 1:30)

scRNA_harmony <- RunUMAP(
  scRNA_harmony,
  reduction = "harmony",
  dims = 1:30,
  umap.method = "uwot",
  metric = "cosine",
  seed.use = 123
)

umap_integrated <- DimPlot(scRNA_harmony, reduction = "umap", label = TRUE, raster = FALSE)
feature_plot <- FeaturePlot(scRNA_harmony, features = "ACTA2", raster = FALSE)

# Subset fibroblasts based on cluster IDs
# Manual cell type annotation was performed by visualizing the expression of marker genes on UMAP plots
scRNA_FB <- scRNA_harmony[, scRNA_harmony@meta.data$seurat_clusters %in% c(
  "...")]

# Re-process fibroblast subset
scRNA_FB <- DietSeurat(scRNA_FB, counts = TRUE, data = TRUE)
scRNA_FB <- NormalizeData(scRNA_FB) %>%
  FindVariableFeatures(selection.method = "vst", nfeatures = 3000) %>%
  ScaleData() %>%
  RunPCA(npcs = 30, verbose = TRUE, seed.use = 42)

# Harmony integration for fibroblast subset
scRNA_FB <- RunHarmony(
  scRNA_FB,
  group.by.vars = "orig.ident",
  random.seed = 123
)

# Clustering, tSNE, and UMAP for fibroblast subset
scRNA_FB <- FindNeighbors(scRNA_FB, reduction = "harmony", dims = 1:30) %>%
  FindClusters(resolution = 1)

scRNA_FB <- RunTSNE(scRNA_FB, reduction = "harmony", dims = 1:30)

scRNA_FB <- RunUMAP(
  scRNA_FB,
  reduction = "harmony",
  dims = 1:30,
  umap.method = "uwot",
  metric = "cosine",
  seed.use = 123
)

umap_integrated_fb <- DimPlot(scRNA_FB, reduction = "umap", label = TRUE, raster = FALSE)
ggsave("FB-CLUSTER.png", umap_integrated_fb, width = 15, height = 8)
feature_plot <- FeaturePlot(scRNA_FB, features = "MMP1", raster = FALSE)

# Calculate differentially expressed genes
cluster_markers <- FindAllMarkers(
  object = scRNA_FB,
  test.use = "wilcox",
  only.pos = TRUE,
  logfc.threshold = 0.25
)
write.csv(cluster_markers, "all_fb_markers.csv", row.names = FALSE)

# Assign sample groups
celltype <- read.csv('celltype1.csv')
scRNA_FB@meta.data$sample_group <- "NA"
for (i in 1:nrow(celltype)) {
  scRNA_FB@meta.data[which(scRNA_FB@meta.data$orig.ident == celltype$ClusterID[i]),
                     'sample_group'] <- celltype$celltype[i]
}
table(scRNA_FB$sample_group)

# Assign cell types
celltype <- read.csv('celltype2.csv')
scRNA_FB@meta.data$celltype <- "NA"
for (i in 1:nrow(celltype)) {
  scRNA_FB@meta.data[which(scRNA_FB@meta.data$seurat_clusters == celltype$ClusterID[i]),
                     'celltype'] <- celltype$celltype[i]
}
table(scRNA_FB$celltype)

