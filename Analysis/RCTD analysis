library(Seurat)
library(fs)
library(patchwork)
library(purrr)

load(FB+MC+LC.RData)
processed_samples <- readRDS("../processed_spatial_samples.rds")

sc_counts <- scRNA_LC_MC_FB@assays[["RNA"]]@counts
Celltype <- as.factor(scRNA_LC_MC_FB$celltype)
names(Celltype) <- colnames(scRNA_LC_MC_FB)

# Build single-cell reference
set.seed(2025)
reference <- Reference(sc_counts, Celltype, n_max_cells = 26000)

# RCTD deconvolution per sample
RCTD_results <- list()   # RCTD objects
P_objects <- list()      # spatial Seurat objects with deconvolution results

for (sample_name in names(processed_samples)) {
  cat("RCTD deconvolving sample:", sample_name, "\n")
  P <- processed_samples[[sample_name]]
  
  # Spatial count matrix
  spatial_count <- GetAssayData(P, assay = "Spatial", slot = "counts")
  
  # Spot coordinates
  coords <- GetTissueCoordinates(P, image = Images(P)[1])[, c("imagerow", "imagecol")]
  colnames(coords) <- c("x", "y")
  
  # SpatialRNA object for spacexr
  query <- SpatialRNA(
    coords = coords,
    counts = spatial_count,
    nUMI = P$nCount_Spatial
  )
  
  # Run RCTD
  RCTD <- create.RCTD(query, reference, max_cores = 1)
  RCTD <- run.RCTD(RCTD, doublet_mode = "full")
  
  # Cell type proportions, normalized to sum to 1 per spot
  weights <- RCTD@results$weights
  norm_weights <- normalize_weights(weights)
  
  # Add proportions to spatial object metadata
  P <- AddMetaData(P, as.data.frame(norm_weights))
  
  RCTD_results[[paste0("RCTD_", sample_name)]] <- RCTD
  P_objects[[paste0("P_", sample_name)]] <- P
}

saveRDS(RCTD_results, "RCTD_results_list.rds")
saveRDS(P_objects, "P_objects_list.rds")

cat("RCTD results saved to working directory\n")


# Visualization
print(names(P_objects))

# Pick a sample
sample_name <- "sample name"

if (!sample_name %in% names(P_objects)) {
  stop(paste("Sample not found:", sample_name))
}

P <- P_objects[[sample_name]]

# Spot coordinates
coords <- GetTissueCoordinates(P, image = Images(P)[1])[, c("imagerow", "imagecol")]

# Metadata columns that are not cell type proportions
meta_cols <- colnames(P@meta.data)
exclude_cols <- c("orig.ident", "nCount_Spatial", "nFeature_Spatial", "percent.mt",
                  "SCT_snn_res.0.8", "seurat_clusters", "image_name", "Spatial_snn_res.0.8")
celltype_cols <- setdiff(meta_cols, exclude_cols)

# Two cell types to compare
feat1 <- "cell type1"
feat2 <- "cell type2"

if (!feat1 %in% celltype_cols) stop(paste("feat1 not found:", feat1))
if (!feat2 %in% celltype_cols) stop(paste("feat2 not found:", feat2))

library(ggnewscale)

df <- data.frame(
  x  = coords[, 1],
  y  = coords[, 2],
  f1 = P[[feat1]][, 1],
  f2 = P[[feat2]][, 1]
)

p <- ggplot(df, aes(x, y)) +
  geom_point(aes(color = f1), size = 0.5, alpha = 0.7) +
  scale_color_gradientn(name = feat1, colours = c("grey90", "red")) +
  new_scale_color() +
  geom_point(aes(color = f2), size = 0.5, alpha = 0.7) +
  scale_color_gradientn(name = feat2, colours = c("grey90", "blue")) +
  coord_fixed() + theme_classic()

print(p)
# The figures generated by this code should be converted to SVG at the maximum length and width, and then manually scaled.
ggsave("co-localization between celltype1 and celltype2.svg", p, width = 50, height = 50)
