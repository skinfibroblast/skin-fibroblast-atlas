# Violin plot for a single subtype score
plot_single_steel_score <- function(seurat_obj,
                                    score_col_name,
                                    celltypes_to_plot = NULL,
                                    colors = c("#FB9A99","#9370DB","#800080","#C73E3A","#FDBF6F","#1F78B4","#B3D88B", "#FF7F00","#64B482","#DDA0DD",
                                                        '#bf033b',"darkred","#A0522D", "#DAA520", "#FFC0CB","#800080","#9370DB", "#DDA0DD",  "#7FFFD4",
                                                        "#00CED1", "#AFEEEE")) {
                                                        
  if (!score_col_name %in% colnames(seurat_obj@meta.data)) {
    stop(paste("Column", score_col_name, "not found. Available columns:\n",
               paste(colnames(seurat_obj@meta.data), collapse = ", ")))
  }
  
  meta <- seurat_obj@meta.data
  meta$celltype <- as.character(meta$celltype)
  
  if (is.null(celltypes_to_plot)) {
    celltypes_to_plot <- unique(meta$celltype)
  } else {
    missing_ct <- setdiff(celltypes_to_plot, unique(meta$celltype))
    if (length(missing_ct) > 0) {
      warning(paste("The following cell types not found:", paste(missing_ct, collapse = ", ")))
    }
    celltypes_to_plot <- intersect(celltypes_to_plot, unique(meta$celltype))
  }
  
  meta_sub <- meta[meta$celltype %in% celltypes_to_plot, ]
  
  # Order cell types by mean score
  avg_scores <- meta_sub %>%
    group_by(celltype) %>%
    summarise(mean_score = mean(.data[[score_col_name]], na.rm = TRUE)) %>%
    arrange(desc(mean_score))
  
  meta_sub$celltype <- factor(meta_sub$celltype, levels = avg_scores$celltype)
  
  p <- ggplot(meta_sub, aes(x = celltype, y = .data[[score_col_name]], fill = celltype)) +
    geom_violin(scale = "width", trim = FALSE, alpha = 0.7) +
    geom_boxplot(width = 0.1, fill = "white", outlier.shape = NA) +
    stat_summary(fun.data = function(x) data.frame(y = mean(x), ymin = mean(x), ymax = mean(x)),
                 geom = "errorbar", width = 0.3, color = "red", size = 1.2) +
    scale_fill_manual(values = colors) +
    theme_bw() +
    theme(axis.text.x = element_text(angle = 45, hjust = 1, size = 15),
          axis.text.y = element_text(size = 15),
          axis.title = element_text(size = 15),
          plot.title = element_text(size = 15, hjust = 0.5),
          legend.position = "none",
          panel.grid = element_blank(),
          panel.border = element_rect(color = "black", fill = NA, linewidth = 1)) +
    labs(title = paste("Module score for", score_col_name),
         x = "Cell type (ordered by mean score)",
         y = "Module score")
  
  print(p)
  return(p)
}
# Disease-F7: Myofibroblast is shown as an example; adjust accordingly for the target cell.
plot_single_steel_score(All_FB, "Disease-F7: Myofibroblast")
ggsave("Steele_Violin.pdf", p, width = 14, height = 10)
