# Read Steele DEG table
load("All_FB.Rdata")
deg_data <- read_excel("41590_2025_2267_MOESM1_ESM.xlsx")
head(deg_data)

# Select top 50 markers per subtype by logFC
N_top <- 50
gene_list <- deg_data %>%
  group_by(Group) %>%
  arrange(desc(logFC), .by_group = TRUE) %>%
  slice_head(n = N_top) %>%
  summarise(genes = list(Gene))

geneset_list <- setNames(gene_list$genes, gene_list$Group)
names(geneset_list)

# Compute module scores
All_FB <- AddModuleScore(
  object = All_FB,
  features = geneset_list,
  name = "Steele_"
)

# Rename score columns to subtype names
score_cols <- grep("^Steele_\\d+$", colnames(All_FB@meta.data), value = TRUE)
for (i in seq_along(score_cols)) {
  All_FB@meta.data[[names(geneset_list)[i]]] <- All_FB@meta.data[[score_cols[i]]]
}
All_FB@meta.data <- All_FB@meta.data[, !colnames(All_FB@meta.data) %in% score_cols]

# Extract metadata and reshape to long format
meta <- All_FB@meta.data
score_cols_new <- names(geneset_list)

plot_data <- meta %>%
  select(celltype, all_of(score_cols_new)) %>%
  pivot_longer(cols = -celltype, names_to = "Steele_Subtype", values_to = "Score")

# Violin plot per subtype
p_violin <- ggplot(plot_data, aes(x = celltype, y = Score, fill = celltype)) +
  geom_violin(scale = "width", trim = FALSE) +
  facet_wrap(~ Steele_Subtype, scales = "free_y", ncol = 4) +
  theme_bw() +
  theme(axis.text.x = element_text(angle = 45, hjust = 1),
        legend.position = "none") +
  labs(title = "Steele subtype gene set scores across our cell types",
       x = "Our cell types", y = "Module score")
print(p_violin)
ggsave("Steele_ModuleScores_Violin.pdf", p_violin, width = 14, height = 10)

