  convert_visium <- function(obj, sample_name, out_dir = ".") {
    
    raw_h5ad   <- file.path(out_dir, paste0(sample_name, "_raw.h5ad"))
    final_h5ad <- file.path(out_dir, paste0(sample_name, ".h5ad"))
    
    # 1. Seurat -> h5ad (Spatial assay counts + metadata)
    sceasy::convertFormat(obj, from = "seurat", to = "anndata",
                          outFile = raw_h5ad, assay = "Spatial")
    
    # 2. Extract spatial info
    coords <- GetTissueCoordinates(obj)
    img    <- obj@images[[1]]@image
    sf     <- obj@images[[1]]@scale.factors
    lib_id <- names(obj@images)[1]
    
    # 3. Write spatial info into anndata via reticulate
    ad <- import("anndata")
    np <- import("numpy")
    adata <- ad$read_h5ad(raw_h5ad)
    
    # Align coords by obs_names
    cell_names <- adata$obs_names$tolist()
    coords_aligned <- as.matrix(coords[cell_names, c("imagecol", "imagerow")])
    
    # Pass to Python
    py$adata     <- adata
    py$coords    <- coords_aligned
    py$img       <- img
    py$lib_id    <- lib_id
    py$fiducial  <- as.numeric(sf$fiducial)
    py$hires     <- as.numeric(sf$hires)
    py$lowres    <- as.numeric(sf$lowres)
    py$final_path <- final_h5ad
    
    py_run_string("
import numpy as np
adata.obsm['spatial'] = coords
adata.uns['spatial'] = {
    lib_id: {
        'images': {'lowres': np.array(img)},
        'scalefactors': {
            'spot_diameter_fullres': 89.5,
            'fiducial_diameter_fullres': fiducial,
            'tissue_hires_scalef': hires,
            'tissue_lowres_scalef': lowres
        }
    }
}
adata.write_h5ad(final_path)
")
    
    cat("Done: ", final_h5ad, "\n")
  }
convert_visium(W1, "W1")
}
