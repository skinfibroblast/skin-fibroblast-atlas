# Load data
library(FSA)
df <- read.csv("cell proportion.csv", row.names = 1)

# Check sample size per group
cat("Sample size per group:\n")
print(table(df$Group))

# Cell type columns (excluding the Group column)
cell_types <- names(df)[-1]

# Kruskal-Wallis test for each cell type, followed by Dunn's post hoc test
for (ct in cell_types) {
  cat("\n========== Cell type:", ct, "==========\n")
  
  kw_res <- kruskal.test(df[[ct]] ~ df$Group)
  cat("Kruskal-Wallis p =", format(kw_res$p.value, digits = 4), "\n")
  
  if (kw_res$p.value < 0.05) {
    cat("Significant, running Dunn's post hoc test (Bonferroni):\n")
    dunn_res <- dunnTest(df[[ct]] ~ df$Group, data = df, method = "bonferroni")
    sig <- dunn_res$res[dunn_res$res$P.adj < 0.05, ]
    if (nrow(sig) > 0) {
      print(sig)
    } else {
      cat("    No significant pairwise differences\n")
    }
  } else {
    cat("Not significant, skipping pairwise comparisons\n")
  }
}

# Summary of overall p values
cat("\n========== Overall p values ==========\n")
p_vals <- sapply(cell_types, function(ct) {
  kruskal.test(df[[ct]] ~ df$Group)$p.value
})
print(p_vals)
