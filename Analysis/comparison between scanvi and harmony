# compare scANVI and Harmony integration
load(".../All_FB.Rdata")

library(Seurat)
library(pheatmap)
library(dplyr)

# row-normalized correspondence between scANVI and Harmony clusters
tab <- table(All_FB$celltype, All_FB$celltype_harmony)
tab_row_pct <- prop.table(tab, margin = 1) * 100

col_order   <- sort(colnames(tab_row_pct))
optimal_col <- apply(tab_row_pct, 1, function(x) colnames(tab_row_pct)[which.max(x)])
row_order   <- rownames(tab_row_pct)[order(match(optimal_col, col_order))]
mat_ordered <- tab_row_pct[row_order, col_order]

A<-pheatmap(mat_ordered,
         cluster_rows  = FALSE,
         cluster_cols  = FALSE,
         display_numbers = FALSE,
         color = colorRampPalette(c("#440154FF","#3B518BFF","#20938CFF","#6ACD5AFF","#FDE725FF"))(100),
         main = "scANVI vs Harmony correspondence (row %)",
         angle_col = 45,
         filename = ".../diagonal.pdf",
         width = 5, height = 5);A

# UMAP colored by Harmony cell type labels
umap_integrated1 <- DimPlot(All_FB, reduction = "umap", label = FALSE,
                            group.by = "celltype_harmony", cols = col)

ggsave(".../celltype.svg", umap_integrated1, width = 5, height = 5)

# summary of best matches per scANVI cluster
diag_stats <- data.frame(
  scANVI_cluster = rownames(tab_row_pct),
  best_Harmony   = apply(tab_row_pct, 1, function(x) colnames(tab_row_pct)[which.max(x)]),
  max_percent    = apply(tab_row_pct, 1, max)
)
print(diag_stats)
cat(sprintf("\nMean max correspondence = %.1f%%\n", mean(diag_stats$max_percent)))
cat(sprintf("Clusters with >70%% correspondence = %.1f%%\n", 100 * mean(diag_stats$max_percent > 70)))

# module scores of scANVI markers in Harmony clusters
marker_gene <- read.csv(".../scANVI_celltype-DEG.csv", row.names = 1)

top_genes <- marker_gene %>%
  group_by(cluster) %>%
  arrange(desc(avg_log2FC)) %>%
  filter(avg_log2FC > 1) %>%
  ungroup()

gene_list <- top_genes %>%
  group_by(cluster) %>%
  summarise(genes = list(gene)) %>%
  deframe()

All_FB <- AddModuleScore(
  object   = All_FB,
  features = gene_list,
  ctrl     = 100,
  name     = "Fb_",
  assay    = "RNA"
)

# rename score columns to cluster names
score_cols <- grep("^Fb_\\d+$", colnames(All_FB@meta.data), value = TRUE)
for (i in seq_along(score_cols)) {
  All_FB@meta.data[[names(gene_list)[i]]] <- All_FB@meta.data[[score_cols[i]]]
}

# dotplot of scANVI marker scores across Harmony clusters
p <- DotPlot(All_FB,
             group.by = "celltype_harmony",
             features = names(gene_list),
             dot.scale = 10) +
  RotatedAxis() +
  scale_colour_gradientn(colours = colorRampPalette(c("navy", "white", "firebrick3"))(100)) +
  labs(title = "scANVI marker scores in Harmony clusters", y = "", x = "")
p
ggsave(".../cellratio.svg", p, width = 9, height = 7)
