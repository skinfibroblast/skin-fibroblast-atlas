# Extract macrophages by Cd68
scRNA_mus_MC= scRNAlist[,scRNAlist@meta.data$seurat_clusters %in% c("...")]

## HVG selection and dimensionality reduction
table(scRNA_mus_MC[[]]$orig.ident)

scRNA_mus_MC <- NormalizeData(scRNA_mus_MC) %>% 
  FindVariableFeatures(selection.method = "vst",nfeatures = 3000) %>% 
  ScaleData() %>% 
  RunPCA(npcs = 30, verbose = T)

## Batch integration
scRNA_mus_MC <- RunHarmony(scRNA_mus_MC, group.by.vars = c("orig.ident"))

## Clustering
scRNA_mus_MC <- FindNeighbors(scRNA_mus_MC, reduction = "harmony", dims = 1:30) %>% FindClusters(resolution = 0.5)
# UMAP/tSNE
scRNA_mus_MC <- RunTSNE(scRNA_mus_MC, reduction = "harmony", dims = 1:30)
scRNA_mus_MC <- RunUMAP(scRNA_mus_MC, reduction = "harmony", dims = 1:30)

tsne_integrated2 <- DimPlot(scRNA_mus_MC, 
                            reduction = "umap",
                            label = TRUE);tsne_integrated2
                            
