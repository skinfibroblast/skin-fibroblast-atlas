load("All_FB.Rdata")
# Build SingleCellExperiment
scale.data <- All_FB@assays$RNA@scale.data
scale.gene <- rownames(scale.data)

counts <- All_FB@assays$RNA@counts
counts <- counts[scale.gene, ]

sim <- SingleCellExperiment(assays = List(counts = counts))

umap <- All_FB@reductions$umap@cell.embeddings
colnames(umap) <- c('UMAP-1', 'UMAP-2')
reducedDims(sim) <- SimpleList(UMAP = umap)

meta <- All_FB@meta.data
colData(sim)$sampleId <- meta$orig.ident
colData(sim)$celltype <- meta$celltype
rd <- umap
plot(rd, col = rgb(0, 0, 0, .5), pch = 16, asp = 1)

sim <- slingshot(sim,
                 clusterLabels = 'celltype',
                 reducedDim = 'UMAP',
                 start.clus = "PI16+ Fb",
                 end.clus = "LRRC15+ Fb"
)

# Plot trajectory with base R
