load("mouse_data.Rdata")                  
scRNA_K <- scRNAlist[, scRNAlist@meta.data$celltype %in% c("Fibroblast")]


# HVG selection
scRNA_K <- FindVariableFeatures(scRNA_K, 
                                selection.method = "vst",
                                nfeatures = 10000,
                                assay = "RNA")

variable_genes <- VariableFeatures(scRNA_K)

# count matrix
countMatrix <- GetAssayData(scRNA_K, assay = "RNA", slot = "counts")

# subset HVGs
countMatrix <- countMatrix[variable_genes, ]

if ('Pi16' %in% rownames(countMatrix)) {
  print("Pi16 is in the countMatrix.")
} else {
  print("Pi16 is not in the countMatrix. You might need to use the whole matrix.")
}

# check mitochondrial genes
mt_genes <- grep("^MT-", rownames(countMatrix), ignore.case = TRUE, value = TRUE)
print(paste("Found", length(mt_genes), "mitochondrial genes"))

if(length(mt_genes) == 0){
  warning("No mitochondrial genes found, setting qc = FALSE")
  qc <- FALSE
} else {
  qc <- TRUE
}

{
  # manual QC
  print("Manual QC filtering...")
  
  lib_size <- colSums(countMatrix)
  print(paste("Min library size:", min(lib_size)))
  print(paste("Max library size:", max(lib_size)))
  print(paste("Mean library size:", mean(lib_size)))
  
  keep_cells_lib <- lib_size >= 2000
  print(paste("Cells passing library size threshold (>=2000):", sum(keep_cells_lib)))
  
  countMatrix_filtered <- countMatrix[, keep_cells_lib]
  
  if(ncol(countMatrix_filtered) < 1000) {
    warning(paste("Too few cells after QC (", ncol(countMatrix_filtered), "), reducing nc_nCells"))
    nc_nCells_adj <- min(200, ncol(countMatrix_filtered))
  } else {
    nc_nCells_adj <- 1000
  }
  
  if(!"Pi16" %in% rownames(countMatrix_filtered)) {
    print("Pi16 not in matrix, adding from original...")
    pi16_row <- countMatrix["Pi16", keep_cells_lib, drop = FALSE]
    rownames(pi16_row) <- "Pi16"
    countMatrix_filtered <- rbind(countMatrix_filtered, pi16_row)
  }
}

result <- scTenifoldKnk(countMatrix = countMatrix_filtered,
                        gKO = 'Pi16',          # KO gene
                        qc = F,                # QC
                        qc_mtThreshold = 0.2,  # MT threshold
                        qc_minLSize = 2000,    # library size threshold
                        nc_nNet = 5,           # subnetworks
                        nc_nCells = 500,       # cells per network
                        nc_nComp = 3,          # PCs
                        nCores = 8
)

